#!/usr/bin/env python3
"""HiFi — run the proxy inside the venv."""

from __future__ import annotations

import os
import sys
from pathlib import Path

_VENV = Path(__file__).resolve().parent / ".venv"
_BIN = _VENV / "bin"

def main() -> None:
    if not (_BIN / "python").exists():
        print(f"Error: venv python not found at {_BIN}/python", file=sys.stderr)
        sys.exit(1)
    # Prepend venv bin to PATH so tools (pip, pytest, uvicorn) are accessible
    os.environ["PATH"] = str(_BIN) + os.pathsep + os.environ.get("PATH", "")
    os.environ["VIRTUAL_ENV"] = str(_VENV)
    os.execv(str(_BIN / "python"), [str(_BIN / "python"), str(Path(__file__).resolve().parent / "main.py")] + sys.argv[1:])

if __name__ == "__main__":
    main()
