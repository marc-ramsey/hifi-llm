#!/usr/bin/env python3
"""HiFi — run commands inside the hifi virtualenv.

Usage:
    ./hifi main.py --config my-config.yaml
    ./hifi -m pytest tests/ -v
    ./hifi -c 'print("hello")'
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

_VENV_PYTHON = Path(__file__).resolve().parent / ".venv" / "bin" / "python"


def main() -> None:
    if not _VENV_PYTHON.exists():
        print(f"Error: venv python not found at {_VENV_PYTHON}", file=sys.stderr)
        sys.exit(1)

    os.execv(str(_VENV_PYTHON), [str(_VENV_PYTHON)] + sys.argv[1:])


if __name__ == "__main__":
    main()
